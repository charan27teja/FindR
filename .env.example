# --- web (apps/web/.env.local) ---
# PLACEHOLDERS ONLY. This file is tracked by git — never paste a real key here.
# Real values go in apps/web/.env.local, which is gitignored.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never NEXT_PUBLIC_. Starts sb_secret_
                                    # (an sbp_ token is an ACCOUNT-wide management
                                    #  token — that is not this, and never belongs here)
NEXT_PUBLIC_SITE_URL=http://localhost:8000   # OAuth redirect origin; matches `next dev -p 8000`
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=
DEMO_MODE=false                     # true -> bypass auth + replay cached AI responses
GEMINI_API_KEY=                     # vision extract runs in Next, not the sidecar
GEMINI_MODEL=gemini-3.6-flash       # 3.x only; 2.5-flash is closed to new keys
RESPONSE_CACHE_DIR=./.cache/vision

# --- ai service (apps/ai/.env) ---
GEMINI_API_KEY=
OPENAI_API_KEY=                     # fallback provider
VISION_PROVIDER=gemini              # gemini | openai
EMBED_MODEL=clip-vit-base-patch32
RESPONSE_CACHE_DIR=./.cache
